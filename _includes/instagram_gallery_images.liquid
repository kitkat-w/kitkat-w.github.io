{% assign ig = site.data.instagram %}
{% assign username = include.username | default: ig.username %}
{% assign profile_url = include.profile_url | default: ig.profile_url %}
{% assign posts = include.posts | default: ig.posts %}
{% assign limit = include.limit | default: 6 %}

{% if profile_url == blank and username != blank %}
  {% capture profile_url %}https://www.instagram.com/{{ username }}/{% endcapture %}
{% endif %}

<div class="igimg-section">
  {% if profile_url != blank %}
    <p class="igimg-cta">
      <a href="{{ profile_url }}" target="_blank" rel="noopener noreferrer">
        {% if username %}@{{ username }}{% else %}Instagram{% endif %}
      </a>
    </p>
  {% endif %}

  {% if posts and posts.size > 0 %}
    <div class="igimg-grid">
      {% for post in posts limit: limit %}
        {% assign post_url = post.url | default: post %}
        {% assign post_image = post.image %}
        {% assign post_alt = post.alt | default: 'Instagram post' %}

        <a class="igimg-card" href="{{ post_url }}" target="_blank" rel="noopener noreferrer">
          {% if post_image %}
            {% assign file_ext = post_image | split: '.' | last %}
            <img
              src="{% if post_image contains '://' %}{{ post_image }}{% else %}{{ post_image | relative_url }}{% endif %}"
              alt="{{ post_alt | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="igimg-missing">
              <div class="igimg-missing__title">Add an image thumbnail</div>
              <div class="igimg-missing__hint">Set <code>image</code> for this post in <code>_data/instagram.yml</code>.</div>
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="igimg-empty">(Optional) Add post links under <code>posts</code> in <code>_data/instagram.yml</code>.</p>
  {% endif %}
</div>

<style>
  .igimg-cta {
    margin: 0 0 0.75rem 0;
    text-align: center;
  }
  .igimg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    align-items: start;
  }
  .igimg-card {
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.02);
    aspect-ratio: 1 / 1;
  }
  .igimg-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .igimg-missing {
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    text-align: left;
  }
  .igimg-missing__title {
    font-weight: 600;
  }
  .igimg-missing__hint {
    opacity: 0.85;
    font-size: 0.95rem;
  }
  .igimg-empty {
    opacity: 0.85;
  }
</style>
