{% assign ig = site.data.instagram %}
{% assign username = include.username | default: ig.username %}
{% assign profile_url = include.profile_url | default: ig.profile_url %}
{% assign posts = include.posts | default: ig.posts %}
{% assign limit = include.limit | default: 6 %}

{% if profile_url == blank and username != blank %}
  {% capture profile_url %}https://www.instagram.com/{{ username }}/{% endcapture %}
{% endif %}

<div class="igimg-section">
  {% if profile_url != blank %}
    <p class="igimg-cta">
      <a href="{{ profile_url }}" target="_blank" rel="noopener noreferrer">
        {% if username %}@{{ username }}{% else %}Instagram{% endif %}
      </a>
    </p>
  {% endif %}

  {% if posts and posts.size > 0 %}
    <div class="igimg-grid">
      {% for post in posts limit: limit %}
        {% assign post_url = post.url | default: post %}
        {% assign post_image = post.image %}
        {% assign post_alt = post.alt | default: 'Instagram post' %}

        {% if post_image %}
          <a class="igimg-card" href="{{ post_url }}" target="_blank" rel="noopener noreferrer">
            <img
              src="{% if post_image contains '://' %}{{ post_image }}{% else %}{{ post_image | relative_url }}{% endif %}"
              alt="{{ post_alt | escape }}"
              loading="lazy"
            >
          </a>
        {% else %}
          {%- comment -%}
            Fallback to the previous behavior (Instagram embed) when no thumbnail image is provided.
          {%- endcomment -%}
          {% assign clean_url = post_url | split: '?' | first %}
          {% assign last_char = clean_url | slice: -1, 1 %}
          {% if last_char != '/' %}
            {% assign clean_url = clean_url | append: '/' %}
          {% endif %}
          {% assign embed_url = clean_url | append: 'embed/' %}

          <div class="igimg-card igimg-card--embed">
            <a
              class="igimg-overlay"
              href="{{ clean_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open Instagram post"
            ></a>
            <div class="igimg-embed-square">
              <iframe
                src="{{ embed_url }}"
                title="Instagram post"
                loading="lazy"
                allowtransparency="true"
                frameborder="0"
                scrolling="no"
              ></iframe>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <p class="igimg-empty">(Optional) Add post links under <code>posts</code> in <code>_data/instagram.yml</code>.</p>
  {% endif %}
</div>

<style>
  .igimg-cta {
    margin: 0 0 0.75rem 0;
    text-align: center;
  }
  .igimg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    align-items: start;
  }
  .igimg-card {
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.02);
    aspect-ratio: 1 / 1;
  }
  .igimg-card--embed {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .igimg-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .igimg-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Cropped Instagram embed (thumbnail-like) */
  .igimg-embed-square {
    position: relative;
    width: 100%;
    padding-top: 100%;
    flex: 1 1 auto;
    background: rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }
  .igimg-embed-square iframe {
    position: absolute;
    left: 0;
    top: -56px; /* crop away most of the Instagram header */
    width: 100%;
    height: calc(100% + 112px); /* compensate for the crop */
    border: 0;
    pointer-events: none; /* allow the tile to click-through to the overlay link */
  }
  .igimg-empty {
    opacity: 0.85;
  }
</style>
