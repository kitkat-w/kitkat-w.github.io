{% assign ig = site.data.instagram %}
{% assign username = include.username | default: ig.username %}
{% assign profile_url = include.profile_url | default: ig.profile_url %}
{% assign posts = include.posts | default: ig.posts %}
{% assign limit = include.limit | default: 6 %}

{% if profile_url == blank and username != blank %}
  {% capture profile_url %}https://www.instagram.com/{{ username }}/{% endcapture %}
{% endif %}

<div class="ig-section">
  {% if profile_url != blank %}
    <p class="ig-cta">
      <a href="{{ profile_url }}" target="_blank" rel="noopener noreferrer">See more on Instagram</a>
    </p>
  {% endif %}

  {% if posts and posts.size > 0 %}
    <div class="ig-grid">
      {% for post_url in posts limit: limit %}
        {% assign clean_url = post_url | split: '?' | first %}
        {% assign last_char = clean_url | slice: -1, 1 %}
        {% if last_char != '/' %}
          {% assign clean_url = clean_url | append: '/' %}
        {% endif %}
        {% assign embed_url = clean_url | append: 'embed/' %}

        <div class="ig-card">
          <div class="ig-embed">
            <iframe
              src="{{ embed_url }}"
              title="Instagram post"
              loading="lazy"
              allowtransparency="true"
              frameborder="0"
              scrolling="no"
            ></iframe>
          </div>
          <div class="ig-link">
            <a href="{{ clean_url }}" target="_blank" rel="noopener noreferrer">Open post</a>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="ig-empty">(Optional) To show posts here, add post links under <code>posts</code> in <code>_data/instagram.yml</code>.</p>
  {% endif %}
</div>

<style>
  .ig-cta {
    margin: 0 0 0.75rem 0;
  }
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .ig-card {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    overflow: hidden;
    background: var(--global-bg-color, #fff);
  }
  .ig-embed {
    position: relative;
    width: 100%;
    padding-top: 125%;
    background: rgba(0, 0, 0, 0.03);
  }
  .ig-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .ig-link {
    padding: 0.5rem 0.75rem;
    font-size: 0.95rem;
  }
  .ig-empty {
    opacity: 0.85;
  }
</style>
